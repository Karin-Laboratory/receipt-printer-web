[Unit]
Description=Receipt Printer Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=receipt-web
Group=receipt-web
WorkingDirectory=/opt/receipt-printer-web
EnvironmentFile=/etc/receipt-printer-web.env
ExecStart=/opt/receipt-printer-web/.venv/bin/gunicorn --workers 2 --threads 2 --bind 127.0.0.1:8000 --timeout 30 app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
